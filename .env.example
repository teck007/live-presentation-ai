MODEL_API_KEY=LLM_...
BACKEND_URL=http://localhost:8000
ASR_MODEL=muse-voice-transcribe-1.0
META_ASR_URL=https://api.meta.ai/v1/asr/transcribe
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
JEV_TOPIC_P=0.6
JEV_ACTION_CONF=0.55
JEV_NEW_CONF=0.68
JEV_TIMEOUT_MS=4000
SLIDE_WINDOW_S=10
WINDOW_DUTY_CYCLE=
SLIDE_CONTEXT_CHARS=600

# --- Auth Clerk (backend only; NUNCA expongas el secret en vars VITE_*) ---
# Sin CLERK_SECRET_KEY el backend corre en modo dev fail-open (usuario dev-local
# con warning en log). En produccion es obligatorio: con secret presente el JWT
# es exigido en /live (POST /api/presentations/generate, POST /api/transcribe,
# WS /ws/transcribe) y el token invalido/ausente da 401 (WS: close 4401).
CLERK_SECRET_KEY=
# Duracion del trial en horas corridas desde registro (default 24).
TRIAL_HOURS=24
# Store local del primer visto por user_id (MVP sin DB real; schema.sql sigue TODO).
TRIAL_STORE_PATH=backend/.trial_first_seen.json

# --- Contacto via Resend (backend only; NUNCA expongas la key en el frontend) ---
# Sin RESEND_API_KEY, POST /api/contact responde 503 explicativo (no crash).
RESEND_API_KEY=
# Destino de los mensajes del formulario (landing + pantalla expirada).
CONTACT_TO=contacto@devstudio.cl
# Remitente verificado. Default onboarding@resend.dev solo sirve en dev y UNICAMENTE
# puede enviar a la casilla duena de la cuenta Resend: en prod usa un remitente de
# tu dominio verificado (ej. contacto@devstudio.cl).
CONTACT_FROM=onboarding@resend.dev
